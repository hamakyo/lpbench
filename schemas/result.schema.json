{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lpbench.dev/schemas/result.schema.json",
  "title": "LPBench Result",
  "type": "object",
  "required": ["runId", "benchmark", "model", "generation", "scores"],
  "properties": {
    "runId": { "type": "string" },
    "benchmark": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "model": {
      "type": "object",
      "required": ["provider", "id", "surface"],
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" },
        "surface": { "enum": ["api", "cli", "web", "manual"] }
      }
    },
    "generation": {
      "type": "object",
      "required": ["durationMs"],
      "properties": {
        "durationMs": { "type": "number", "minimum": 0 },
        "ttftMs": { "type": "number", "minimum": 0 },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": { "type": "number", "minimum": 0 },
            "outputTokens": { "type": "number", "minimum": 0 },
            "reasoningTokens": { "type": "number", "minimum": 0 },
            "cachedTokens": { "type": "number", "minimum": 0 },
            "totalTokens": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "properties": {
        "billing": { "enum": ["api", "subscription", "unknown"] },
        "actualUsd": { "type": "number", "minimum": 0 },
        "estimatedApiEquivalentUsd": { "type": "number", "minimum": 0 },
        "pricingDate": { "type": "string" }
      }
    },
    "scores": {
      "type": "object",
      "required": ["total"],
      "properties": {
        "visual": { "type": "number" },
        "responsive": { "type": "number" },
        "functionality": { "type": "number" },
        "accessibility": { "type": "number" },
        "compliance": { "type": "number" },
        "codeQuality": { "type": "number" },
        "technical": { "type": "number" },
        "total": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "efficiency": {
      "type": "object",
      "properties": {
        "scorePer1kOutputTokens": { "type": "number" },
        "scorePer1kTotalTokens": { "type": "number" },
        "scorePerDollar": { "type": "number" },
        "scorePerSecond": { "type": "number" },
        "outputTokensPerSecond": { "type": "number" }
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "lines": { "type": "integer", "minimum": 0 },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "lighthouse": {
      "type": "object",
      "required": ["evaluator", "status"],
      "properties": {
        "evaluator": { "const": "lighthouse" },
        "status": { "enum": ["ok", "skipped", "failed"] },
        "warning": { "type": "string" },
        "metrics": {
          "type": "object",
          "properties": {
            "performance": { "type": "number", "minimum": 0, "maximum": 1 },
            "accessibility": { "type": "number", "minimum": 0, "maximum": 1 },
            "bestPractices": { "type": "number", "minimum": 0, "maximum": 1 },
            "seo": { "type": "number", "minimum": 0, "maximum": 1 },
            "lcpMs": { "type": "number", "minimum": 0 },
            "cls": { "type": "number", "minimum": 0 },
            "tbtMs": { "type": "number", "minimum": 0 },
            "speedIndexMs": { "type": "number", "minimum": 0 },
            "interactiveMs": { "type": "number", "minimum": 0 }
          }
        }
      },
      "if": {
        "properties": { "status": { "const": "ok" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "metrics": { "type": "object", "minProperties": 1 } },
        "required": ["metrics"]
      }
    }
  }
}
